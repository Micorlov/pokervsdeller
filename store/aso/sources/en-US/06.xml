lse" long-clickable="false" password="false" selected="false" bounds="[0,128][1080,2337]"><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,191][1017,363]"><node index="0" text="How to play" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,191][1017,303]" /><node index="1" text="Showdown — three seats against the house's climb." resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,313][1017,362]" /></node><node index="1" text="" resource-id="" class="android.view.ViewGroup" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,405][1017,779]"><node index="0" text="1" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,405][137,479]" /><node index="1" text="Two antes, two battles" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,405][1017,472]" /><node index="2" text="Every seat puts one ante into the Table Pot and stakes another against the house. You are fighting the dealer for your stake and the whole table for the pot — and the pot swallows the chips of everyone who loses along the way." resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,479][1017,779]" /></node><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,821][1017,1196]"><node index="0" text="2" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,821][137,895]" /><node index="1" text="Pick your kicker" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,821][1017,888]" /><node index="2" text="You get five cards; the dealer starts with none. Before the climb, secretly mark one card as your kicker. If its rank matches the dealer's final card and you beat the dealer, your winnings double — a Kicker Strike." resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,895][1017,1195]" /></node><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1238][1017,1763]"><node index="0" text="3" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1238][137,1312]" /><node index="1" text="The house's climb" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,1238][1017,1305]" /><node index="2" text="The dealer builds a hand one face-up card at a time. After each of the first four cards you choose: HOLD and stay in, FORGE a card away for a fresh one from the deck (one ante into the pot, 2 per hand, never the kicker), or BAIL and take half of everything you have put in straight back — the stake you abandon falls into the Table Pot." resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,1312][1017,1762]" /></node><node index="4" text="" resource-id="" class="android.view.ViewGroup" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1805][1017,2130]"><node index="0" text="4" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,1805][137,1879]" /><node index="1" text="The pressure round" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,1805][1017,1872]" /><node index="2" text="After the dealer's third card only, you may double your stake against the house. Beat the dealer from there and the doubled stake pays 3 to 1 instead of even money." resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,1879][1017,2129]" /></node><node index="5" text="" resource-id="" class="android.view.ViewGroup" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,2172][1017,2337]"><node index="0" text="5" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,2172][137,2246]" /><node index="1" text="Showdown" resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,2172][1017,2239]" /><node index="2" text="The fifth card ends the climb. Beat the dealer's five and your stake pays out; every beaten stake joins the pot, and the best hand left at the table takes all of it — antes, forge fees, and everything the losers left behind. Do both outright and that is a Sweep — 5 antes extra, on the house." resource-id="" class="android.widget.TextView" package="com.micorlov.pokervsdealer" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[179,2246][1017,2337]" /></node></node></node></node></node></node></node></node></node></node></node></node></hierarchy>