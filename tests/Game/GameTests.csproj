<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone harness for the Showdown game layer (state, clock, storage, table controller): compiles the
    pure-C# Unity sources (no copies) together with the NUnit tests and a tiny reflection runner, so the suite
    runs without opening Unity. Only Domain/, Runtime/Game/Contracts.cs and Runtime/Game/Logic/ are compiled;
    anything touching UnityEngine lives in Runtime/Game/Platform/ and is covered by scripts/check.sh instead.
    Build and run through scripts/game-test.sh.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity 6 compiles C# 9; keep the harness honest about that. -->
    <LangVersion>9.0</LangVersion>
    <AssemblyName>ShowdownGameTests</AssemblyName>
    <RootNamespace>Showdown.Tests.Harness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The real System.Runtime.CompilerServices.IsExternalInit exists on net8.0. -->
    <DefineConstants>$(DefineConstants);SHOWDOWN_DOTNET_HARNESS</DefineConstants>
    <!-- bin/ and obj/ stay in this folder (gitignored via /tests/**/bin and /obj). -->
    <BaseOutputPath>bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Showdown/Domain/**/*.cs" />
    <Compile Include="../../Assets/Showdown/Runtime/Game/Contracts.cs" />
    <Compile Include="../../Assets/Showdown/Runtime/Game/Logic/**/*.cs" />
    <Compile Include="../../Assets/Showdown/Tests/Game/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unity's own NUnit 3.5, so the tests are compiled against the API they run on in the Editor. -->
    <Reference Include="nunit.framework">
      <HintPath>$(UnityEditorRoot)/Unity.app/Contents/Resources/PackageManager/BuiltInPackages/com.unity.ext.nunit/net472/unity-custom/nunit.framework.dll</HintPath>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <UnityEditorRoot Condition="'$(UnityEditorRoot)' == ''">/Applications/Unity/Hub/Editor/6000.5.8f1</UnityEditorRoot>
  </PropertyGroup>

</Project>
